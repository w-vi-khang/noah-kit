{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": 1,
  "kit": {
    "id": "noah-kit",
    "version": "0.1.0",
    "core_version_range": ">=0.1.0 <0.2.0"
  },
  "project": {
    "id": "replace-with-stable-project-id",
    "name": "replace-with-project-name",
    "type": "application"
  },
  "installation": {
    "prompt_on_missing_core": true,
    "remember_declined_install_locally": true
  },
  "updates": {
    "check_on_startup": true,
    "auto_install": false,
    "check_after_local_time": "17:00",
    "timezone": "Asia/Ho_Chi_Minh",
    "remind_after_days": 1,
    "channel": "stable"
  },
  "capabilities": {
    "skills": true,
    "subagents": true,
    "hooks": false,
    "migrations": false
  }
}
